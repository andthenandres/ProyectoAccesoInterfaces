<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../Images/fondoRegistro.jpg" />
         </image>
      </ImageView>
      <Label layoutX="236.0" layoutY="47.0" text="Registro de usuario" />
      <Label layoutX="157.0" layoutY="122.0" text="Nombre de usuario:" />
      <Label layoutX="157.0" layoutY="169.0" text="Contraseña:" />
      <Label layoutX="157.0" layoutY="223.0" text="Genero:" />
      <Label layoutX="164.0" layoutY="276.0" text="Lenguaje de programacion:" />
      <TextField fx:id="TFUsuario" layoutX="282.0" layoutY="118.0" />
      <TextField fx:id="TFContrasena" layoutX="282.0" layoutY="166.0" />
      <RadioButton fx:id="RBHombre" layoutX="249.0" layoutY="223.0" mnemonicParsing="false" text="Hombre">
         <toggleGroup>
            <ToggleGroup fx:id="grupoGenero" />
         </toggleGroup></RadioButton>
      <RadioButton fx:id="RBMujer" layoutX="324.0" layoutY="223.0" mnemonicParsing="false" text="Mujer" toggleGroup="$grupoGenero" />
      <RadioButton fx:id="RBPrefiero" layoutX="389.0" layoutY="223.0" mnemonicParsing="false" text="Prefiero no decirlo" toggleGroup="$grupoGenero" />
      <ComboBox fx:id="CBLenguaje" layoutX="324.0" layoutY="272.0" prefWidth="150.0" />
      <Button fx:id="BotonRegistrar" layoutX="220.0" layoutY="341.0" mnemonicParsing="false" text="Registrar" />
      <Button fx:id="BotonVolver" layoutX="363.0" layoutY="341.0" mnemonicParsing="false" text="Volver al login" />
      <ImageView fitHeight="39.0" fitWidth="42.0" layoutX="159.0" layoutY="334.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../Images/logoRegistro.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
